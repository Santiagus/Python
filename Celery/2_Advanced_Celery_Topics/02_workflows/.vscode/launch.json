{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8010",
                "--reload"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "DATABASE_URL": "postgresql+asyncpg://postgres:postgres@localhost:5433/underwriting_db",
                "ENVIRONMENT": "development",
                "LOG_LEVEL": "INFO",
                "LOG_FORMAT": "pretty"
            },
            "justMyCode": true
        }
    ]
}