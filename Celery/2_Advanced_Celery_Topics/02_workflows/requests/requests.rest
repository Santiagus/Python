# ==============================================================================
# Commercial Credit Underwriting Workflow - REST Client Test Suite
# ==============================================================================
# Organized in self-contained test workflows. For each test scenario, execute the
# steps in order from top to bottom:
#   Step A: POST application (or application + manifest for Fast Track)
#   Step B: GET application status before dossier (shows "pending" awaiting docs)
#   Step C: POST dossier manifest (dispatches Celery Canvas workflow)
#   Step D: POST dossier manifest again (tests idempotency / "already-registered")
#   Step E: GET application status (polls final decision memo, audit flags & summary)
# ==============================================================================

@clientUrl = http://localhost:8010
@baseUrl = {{clientUrl}}
@apiPrefix = /api/v1

# Port 8010 matches VS Code debug configurations.
# If running via docker-compose with a different port (e.g. 8001), toggle:
# @clientUrl = http://localhost:8001


# ==============================================================================
# 0. SYSTEM HEALTH CHECK
# ==============================================================================

###
# 0.1 Health Check (Database, Broker, and Worker connectivity)
GET {{baseUrl}}/health


# ==============================================================================
# TEST SCENARIO 1: CLEAN 4-PAGE DOSSIER (Standard Two-Step Ingestion -> Approved)
# ==============================================================================

###
# 1.1 POST Application (Initializes application in "pending" status, awaiting dossier)
# @name createCleanApp
POST {{baseUrl}}{{apiPrefix}}/applications
Content-Type: application/json

{
  "company_name": "Apex Fintech Dynamics Inc.",
  "applicant_name": "JANE DOE",
  "requested_facility": 250000.00
}


###
# 1.2 GET Application Status Before Dossier (Expected: status "pending", memo null)
GET {{baseUrl}}{{apiPrefix}}/applications/{{createCleanApp.response.body.application_id}}


###
# 1.3 POST Dossier Manifest (Submits clean 4-page dossier -> Dispatches Celery chord)
POST {{baseUrl}}{{apiPrefix}}/applications/{{createCleanApp.response.body.application_id}}/dossier
Content-Type: application/json

{
  "manifest": {
    "bank_statement": "tests/fixtures/clean_4pages/bank_statement_4pages.pdf",
    "kyc_id": "tests/fixtures/clean_4pages/kyc_executive_id.jpg",
    "tax_filing": "tests/fixtures/clean_4pages/tax_filing_irs1120.pdf"
  }
}


###
# 1.4 POST Dossier Manifest Again (Idempotency Guard -> Returns "already registered")
POST {{baseUrl}}{{apiPrefix}}/applications/{{createCleanApp.response.body.application_id}}/dossier
Content-Type: application/json

{
  "manifest": {
    "bank_statement": "tests/fixtures/clean_4pages/bank_statement_4pages.pdf",
    "kyc_id": "tests/fixtures/clean_4pages/kyc_executive_id.jpg",
    "tax_filing": "tests/fixtures/clean_4pages/tax_filing_irs1120.pdf"
  }
}


###
# 1.5 GET Application Status & Decision Memo (Expected: status "approved", memo compiled)
GET {{baseUrl}}{{apiPrefix}}/applications/{{createCleanApp.response.body.application_id}}


###
# 1.6 GET Stage-by-Stage Latency Telemetry (Stage 1, 2, 3 wall-clock timings in ms)
GET {{baseUrl}}{{apiPrefix}}/applications/{{createCleanApp.response.body.application_id}}/timing


# ==============================================================================
# TEST SCENARIO 2: FAST-TRACK INGESTION (Application + Manifest in Single Step)
# ==============================================================================

###
# 2.1 POST Application + Manifest (Creates and immediately dispatches workflow)
# @name createFastTrackApp
POST {{baseUrl}}{{apiPrefix}}/applications
Content-Type: application/json

{
  "company_name": "Fast Track Lending LLC",
  "applicant_name": "JANE DOE",
  "requested_facility": 300000.00,
  "manifest": {
    "bank_statement": "tests/fixtures/clean_4pages/bank_statement_4pages.pdf",
    "kyc_id": "tests/fixtures/clean_4pages/kyc_executive_id.jpg",
    "tax_filing": "tests/fixtures/clean_4pages/tax_filing_irs1120.pdf"
  }
}


###
# 2.2 POST Dossier Manifest to Fast-Track App (Idempotency Guard -> "already registered")
POST {{baseUrl}}{{apiPrefix}}/applications/{{createFastTrackApp.response.body.application_id}}/dossier
Content-Type: application/json

{
  "manifest": {
    "bank_statement": "tests/fixtures/clean_4pages/bank_statement_4pages.pdf",
    "kyc_id": "tests/fixtures/clean_4pages/kyc_executive_id.jpg",
    "tax_filing": "tests/fixtures/clean_4pages/tax_filing_irs1120.pdf"
  }
}


###
# 2.3 GET Application Status & Decision Memo (Expected: status "approved")
GET {{baseUrl}}{{apiPrefix}}/applications/{{createFastTrackApp.response.body.application_id}}


###
# 2.4 GET Fast-Track Telemetry Timings
GET {{baseUrl}}{{apiPrefix}}/applications/{{createFastTrackApp.response.body.application_id}}/timing


