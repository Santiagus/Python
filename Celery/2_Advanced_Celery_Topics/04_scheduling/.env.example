# Environment Configuration Specimen for 04_scheduling
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Database Configuration (Asyncpg + Sync)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scheduling_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scheduling_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_WORKER_POOL_SIZE=2
DB_WORKER_MAX_OVERFLOW=2

# Message Broker & Result Backend
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
REDIS_URL=redis://localhost:6379/0

# Scheduling & Timezone
CELERY_TIMEZONE=America/New_York
IDEMPOTENCY_RETENTION_DAYS=30
LEADER_LEASE_TTL_SECONDS=15
LEADER_HEARTBEAT_INTERVAL_SECONDS=5

