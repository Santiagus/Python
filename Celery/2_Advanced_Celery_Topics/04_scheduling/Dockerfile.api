# =============================================================================
# FastAPI Ingestion Gateway Dockerfile (The Producer)
# =============================================================================

FROM python:3.11-slim

WORKDIR /workspace

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements_api.txt /workspace/requirements_api.txt
RUN pip install --no-cache-dir -r /workspace/requirements_api.txt

COPY app/ /workspace/app/
COPY services/__init__.py /workspace/services/__init__.py
COPY services/worker/ /workspace/services/worker/

ENV PYTHONPATH=/workspace
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
