# =============================================================================
# Multi-Rail Payment Orchestrator Environment Variables Template
# =============================================================================

# Database Connections
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/payments_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payments_db

# Message Broker & Result Store
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
REDIS_URL=redis://localhost:6379/0

# Partner Bank Simulator API
BANK_API_URL=http://localhost:8011

# Security & Operations
ENVIRONMENT=development
LOG_LEVEL=INFO
API_KEY=sk_live_payment_orchestrator_secret_key_2026
RATE_LIMIT_RPM=600

# Celery Routing Architecture
BATCH_CHUNK_SIZE=100
CRITICAL_QUEUE=critical
DEFAULT_QUEUE=default
BULK_QUEUE=bulk
DLQ_QUEUE=rejected_payments

