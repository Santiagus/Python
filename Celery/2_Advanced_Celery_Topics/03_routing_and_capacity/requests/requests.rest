  "destination_routing_number": "021000021",
  "amount": "250.00",
  "rail": "fednow",
  "description": "Idempotency test payload"
}


### =============================================================================
### 4. High-Volume Batch Settlement Workflow (.chunks(100) on 'bulk' queue)
### =============================================================================

### 4.1 Submit Payroll Batch (Captures batch_id dynamically)
# @name createPayrollBatch
POST {{baseUrl}}/disbursements/batch
X-API-Key: {{apiKey}}
Content-Type: application/json
Accept: application/json

{
  "file_reference": "nacha_payroll_cycle_{{$datetime iso8601}}",
  "source_account_id": "{{payrollAccountId}}",
  "disbursements": [
    {
      "recipient_name": "Alice Developer",
      "account_number": "111122223333",
      "routing_number": "021000021",
      "amount": "3450.00"
    },
    {
      "recipient_name": "Bob Architect",
      "account_number": "444455556666",
      "routing_number": "021000021",
      "amount": "4200.00"
    },
    {
      "recipient_name": "Carol Designer",
      "account_number": "777788889999",
      "routing_number": "021000021",
      "amount": "2950.00"
    }
  ]
}

### 4.2 Poll Batch Settlement Progress
GET {{baseUrl}}/disbursements/batch/{{createPayrollBatch.response.body.batch_id}}
X-API-Key: {{apiKey}}
Accept: application/json


